{
  "name": "twitch-win-challenge",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "wrangler dev --host localhost:8787 --define __DEV__:true",
    "typecheck": "wrangler types && tsc --noEmit",
    "types": "wrangler types",
    "test": "node --experimental-strip-types --test src/test_run.ts src/test_timer.ts src/test_gofundme.ts",
    "build": "wrangler deploy --dry-run --outdir dist --minify && rm -f dist/*.map",
    "verify:dce": "npm run build && test -f dist/index.js && ! grep -r dev@localhost dist",
    "migrate:local": "wrangler d1 migrations apply twitch-win-challenge-db --local",
    "migrate:remote": "wrangler d1 migrations apply twitch-win-challenge-db --remote",
    "check": "npm run typecheck && npm run test && npm run verify:dce",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": { "jose": "^6" },
  "devDependencies": { "wrangler": "^4.147.0", "typescript": "^5", "@types/node": "^24" }
}
